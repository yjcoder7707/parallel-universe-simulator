from abc import ABC, abstractmethod

# 1. CHARACTER CLASS

class Character:

    def __init__(self, name, age, profession):
        self.name = name
        self.age = age
        self.profession = profession

    def show_details(self):
        print("Character Name:", self.name)
        print("Age:", self.age)
        print("Profession:", self.profession)

# 2. UNIVERSE CLASS


class Universe:

    def __init__(self, universe_name, description):
        self.universe_name = universe_name
        self.description = description
        self.characters = []

    def add_character(self, character):
        self.characters.append(character)
        print(character.name, "has entered", self.universe_name)

    def show_universe(self):
        print("\nUniverse:", self.universe_name)
        print("Description:", self.description)

        print("\nCharacters:")

        for character in self.characters:
            print("-", character.name)

    def execute_event(self, event):
        print("\nEvent happening in", self.universe_name)
        event.execute_event()

# 3. ALTERNATE CHARACTER CLASS


class AlternateCharacter(Character):

    def __init__(self, name, age, profession, universe):
        super().__init__(name, age, profession)
        self.universe = universe

    def show_details(self):
        print("\nCharacter:", self.name)
        print("Age:", self.age)
        print("Profession:", self.profession)
        print("Universe:", self.universe)

# 4. POLYMORPHISM


class Scientist(AlternateCharacter):

    def special_ability(self):
        print(self.name, "can conduct scientific experiments.")


class Businessman(AlternateCharacter):

    def special_ability(self):
        print(self.name, "can manage international businesses.")


class Astronaut(AlternateCharacter):

    def special_ability(self):
        print(self.name, "can explore outer space.")


class Doctor(AlternateCharacter):

    def special_ability(self):
        print(self.name, "can treat patients and save lives.")


# 5. ENCAPSULATION


class CharacterStatus:

    def __init__(self, name):
        self.name = name
        self.__energy = 100

    def get_energy(self):
        return self.__energy

    def use_energy(self, amount):

        if amount > 0 and amount <= self.__energy:
            self.__energy -= amount
            print(amount, "energy used.")

        else:
            print("Invalid energy amount!")

    def show_status(self):
        print("\nCharacter:", self.name)
        print("Remaining Energy:", self.__energy)


# 6. ABSTRACTION


class UniverseEvent(ABC):

    @abstractmethod
    def execute_event(self):
        pass


class WarEvent(UniverseEvent):

    def execute_event(self):
        print("A war has started in the universe!")


class DiscoveryEvent(UniverseEvent):

    def execute_event(self):
        print("A new planet has been discovered!")


class PeaceEvent(UniverseEvent):

    def execute_event(self):
        print("Peace has been established in the universe!")


